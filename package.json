{
  "name": "medwear-health-analytics",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "description": "MedWear Health Analytics — 人机协同慢病与肿瘤早筛研究平台",
  "author": "MedWear Research",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.15.12",
    "@mui/material": "^5.15.12",
    "adm-zip": "^0.5.16",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "multer": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2",
    "sax": "^1.4.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "node server.js",
    "free-ports": "node scripts/free-ports.js",
    "stop": "node scripts/free-ports.js",
    "dev": "node scripts/dev.js",
    "app": "node scripts/start-app.js",
    "app:fresh": "npm run build && node scripts/start-app.js",
    "start:prod": "NODE_ENV=production node server.js",
    "pack:zip": "node scripts/pack-zip.js",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && electron-builder",
    "desktop:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "desktop:win": "npm run build && electron-builder --win",
    "test:ai": "node scripts/test-ai.js",
    "evaluate": "node scripts/evaluate-analytics.js",
    "generate:cohort": "node scripts/generate-screening-cohort.js",
    "evaluate:outcomes": "node scripts/evaluate-screening-outcomes.js",
    "validate:cohort": "node scripts/validate-clinical-cohort.js",
    "export:features": "node scripts/export_features.js",
    "generate:synth-health": "node scripts/generate_synthetic_healthdata.js --users 200 --days 14",
    "experiment:export": "npm run export:features",
    "experiment:train": "python experiments/medwear/train.py --data experiments/data/medwear/features_v1.csv --model rf --cv 5 --seed 42",
    "experiment:summary": "python experiments/medwear/evaluate.py --results experiments/results --out experiments/results/summary.csv"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "proxy": "http://localhost:3001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react-scripts": "^5.0.1"
  },
  "build": {
    "extends": null,
    "appId": "com.medwear.health.analytics",
    "productName": "MedWear Health Analytics",
    "copyright": "Copyright © 2026 MedWear Research",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "server.js",
      "server/**/*",
      "!server/__tests__/**",
      "scripts/evaluate-screening-outcomes.js",
      "scripts/validate-clinical-cohort.js",
      "benchmarks/screening-outcome-dataset.json",
      "benchmarks/wearable-analytics-dataset.json",
      "docs/METHODS.md",
      "docs/EVALUATION.md",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "afterPack": "scripts/after-pack-mac.js",
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "MedWear-${version}-${os}.${ext}"
    },
    "dmg": {
      "title": "MedWear Health Analytics ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "MedWear-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MedWear Health Analytics"
    }
  }
}
